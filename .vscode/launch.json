    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Board",
            "request": "launch",
            "mainClass": "redemption.redemption.Board",
            "projectName": "Redemption"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "App",
            "request": "launch",
            "mainClass": "redemption.server.App",
            "projectName": "Redemption",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "type": "java",
            "name": "AppTest",
            "request": "launch",
            "mainClass": "redemption.server.AppTest",
            "projectName": "Redemption"
        },
        {
            "type": "java",
            "name": "GameController",
            "request": "launch",
            "mainClass": "redemption.server.game.GameController",
            "projectName": "Redemption"
        }
    ]
}